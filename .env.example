ISDASAFE_ANDROID_MAPS_KEY=
ISDASAFE_WEB_MAPS_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Fill these in after completing the Google Cloud Console steps in
# docs/AUTH_SETUP.md (Google Sign-In section). Leave blank until then.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Cloudflare Turnstile site key (public — safe client-side). Fill in after
# completing docs/AUTH_SETUP.md's Turnstile CAPTCHA section. Leave blank
# until then; the login/register/forgot-password screens show a clear
# "missing TURNSTILE_SITE_KEY" message instead of crashing when it's empty.
TURNSTILE_SITE_KEY=
